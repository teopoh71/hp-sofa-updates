{
    "patchVersionCode":  31,
    "patchVersionName":  "v183-force-nikator-front-thumbs",
    "notes":  [
                  "Force reapply of the v182 Nikator front thumbnail patch on phones that cached the old grid.",
                  "Uses Nikator model-folder product photos for quick buttons instead of effect-gallery photos.",
                  "Keeps corrected front-facing button photos for NK0042, NK0024, LE8802, NK0050, and NK0035.",
                  "Keeps tighter cropped thumbnails and visible version text."
              ],
