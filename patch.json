{
  "patchVersionCode": 41,
  "patchVersionName": "v208-zl3776-showroom-mixed-price",
  "notes": [
    "Adds corrected ZL3776 showroom set with Chinese showroom label and shortage remark.",
    "Sets showroom dimensions from actual sides: ARM + 1NA/LONG + 1NA + 1NA + CORNER = 4300mm, return side = 3970mm.",
    "Adds per-position material selectors on mobile and defaults showroom mix to F/SA x3 + M/F x5.",
    "Uses clean line drawings for ZL3776 part thumbnails and removes repeated AURONZO text from slot options."
  ],
